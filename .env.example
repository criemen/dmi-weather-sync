# DMI Weather Sync - Environment Variables
#
# Windguru passwords are stored here, one per station.
# The variable name format is: WINDGURU_PASSWORD_{STATION_NAME}
# where {STATION_NAME} is the station name from stations.toml
# converted to uppercase with spaces/special chars as underscores.
#
# Example: If your stations.toml has:
#   ["Copenhagen Harbor"]
#   ["Aarhus Beach"]
#
# Then you need these environment variables:

WINDGURU_PASSWORD_COPENHAGEN_HARBOR=your_password_here
WINDGURU_PASSWORD_AARHUS_BEACH=your_password_here
