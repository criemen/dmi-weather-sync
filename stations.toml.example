# DMI Weather Sync - Station Configuration
#
# Each section defines a weather station to sync.
# The section name (in quotes) becomes the station name used in logs
# and for password environment variable lookup.
#
# Password environment variables use the format:
#   WINDGURU_PASSWORD_{STATION_NAME}
# Where {STATION_NAME} is uppercase with spaces/special chars as underscores.
# Example: "Copenhagen Harbor" -> WINDGURU_PASSWORD_COPENHAGEN_HARBOR

["Copenhagen Airport"]
dmi_station_id = "06180"
windguru_uid = "your-windguru-station-uid"

["Aarhus Beach"]
dmi_station_id = "06070"
windguru_uid = "another-windguru-station-uid"

# Find DMI station IDs at:
# https://opendatadocs.dmi.govcloud.dk/en/Guides/Station_Lists_Explained
#
# Get your Windguru station UID from your Windguru station settings
